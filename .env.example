# Copie para .env e preencha. Na Vercel, cadastre estas mesmas variáveis em Settings → Environment Variables.
# URL pública do Postgres do Railway (variável DATABASE_PUBLIC_URL do serviço Postgres).
DATABASE_URL=postgresql://postgres:SENHA@HOST.proxy.rlwy.net:PORTA/railway
USER_PASSWORD=senha-dos-participantes
ADMIN_PASSWORD=senha-do-administrador
SESSION_SECRET=texto-longo-e-aleatorio-com-pelo-menos-32-caracteres
